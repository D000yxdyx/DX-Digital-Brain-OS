# ============================================================================
# DX Digital Brain OS — runtime configuration template
#
# This file documents the AUTHORITATIVE environment-variable contract consumed by
# ``dxbrain.config.Settings`` and ``dxbrain.config.WorkerSettings``. It contains NO
# real secrets — every value below is a placeholder. Keep real values only in the
# local ``.env`` (which is never committed).
# ============================================================================

# ---------------------------------------------------------------------------
# 1. DATABASE ROLE DSNs  (least-privilege principals)
# ---------------------------------------------------------------------------
# These three DSNs each name an explicit least-privilege Postgres role and are the
# canonical place the real credentials live. The application runtime and Alembic
# then SELECT which role they need (see section 2), they do NOT reuse these keys
# directly by name.

# owner of migrations (schema DDL) — used by Alembic ONLY, never by the app runtime.
DX_DATABASE_URL_MIGRATION=postgresql+psycopg://dx_migration:replace-with-migration-password@127.0.0.1:5432/dxbrain
# API / operator read-write principal.
DX_DATABASE_URL_API=postgresql+psycopg://dx_api:replace-with-api-password@127.0.0.1:5432/dxbrain
# outbox worker lease principal (read-only outbox).
DX_DATABASE_URL_WORKER=postgresql+psycopg://dx_worker:replace-with-worker-password@127.0.0.1:5432/dxbrain

# ---------------------------------------------------------------------------
# 2. APPLICATION RUNTIME  (Settings)
# ---------------------------------------------------------------------------
# ``Settings`` consumes DX_DATABASE_URL, which MUST be the dx_api DSN. In a local
# session, source the role DSNs above and map:
#
#   DX_DATABASE_URL           = DX_DATABASE_URL_API     (dx_api  / dxbrain)
#
# The two worker-side URLs below are consumed by ``WorkerSettings``, not ``Settings``.
DX_DATABASE_URL=postgresql+psycopg://dx_api:replace-with-api-password@127.0.0.1:5432/dxbrain
DX_ROOT_API_KEY=replace-with-a-long-random-local-key
DX_CONTROL_UI_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# ---------------------------------------------------------------------------
# 3. WORKER / EXECUTION  (WorkerSettings)
# ---------------------------------------------------------------------------
# ``WorkerSettings`` consumes DX_WORKER_DATABASE_URL (dx_worker, outbox lease) and,
# optionally, DX_EXECUTION_DATABASE_URL (dx_api, the Execution Gateway principal).
# Map in a local session:
#
#   DX_WORKER_DATABASE_URL    = DX_DATABASE_URL_WORKER   (dx_worker / dxbrain)
#   DX_EXECUTION_DATABASE_URL = DX_DATABASE_URL_API      (dx_api    / dxbrain)
#
# DX_EXECUTION_DATABASE_URL has NO fallback: when absent, the Execution Gateway is
# not wired at all and the worker keeps its original behaviour.
DX_WORKER_DATABASE_URL=postgresql+psycopg://dx_worker:replace-with-worker-password@127.0.0.1:5432/dxbrain
DX_EXECUTION_DATABASE_URL=postgresql+psycopg://dx_api:replace-with-api-password@127.0.0.1:5432/dxbrain

# ---------------------------------------------------------------------------
# 4. REAL AGENT EXECUTION  (E.3B)
# ---------------------------------------------------------------------------
# Master switch for real (vs fake) agent execution. Absent -> False.
DX_AGENT_EXECUTION_ENABLED=false
# Static symbolic workspace map: "workspace_ref" -> absolute directory. Absent ->
# empty map -> every workspace reference is unknown and therefore denied. Use a
# JSON object, e.g. {"e5a-readonly": "E:\\DX_Workspace\\e2e-real-acceptance-001"}.
DX_AGENT_WORKSPACES={}
# The approved NATIVE Codex executable (absolute path, .exe suffix, MZ binary).
# DX never discovers a Codex installation; an unusable value fails fast at worker
# construction. Use a placeholder here — never commit a machine-specific path.
DX_CODEX_EXECUTABLE=C:\path\to\codex.exe
# Process-local MCP isolation: a JSON array of Codex MCP server NAMES to disable for
# the provider's child process only. Absent -> empty -> no isolation overrides.
DX_CODEX_DISABLED_MCP_SERVERS=[]

# ---------------------------------------------------------------------------
# 5. MODEL PROVIDERS  (planner / reviewer / live-call controls)
# ---------------------------------------------------------------------------
# Keep keys only in the local .env; never commit them.
DEEPSEEK_API_KEY=replace-with-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
ANTHROPIC_API_KEY=replace-with-anthropic-key
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-sonnet-4-20250514
DX_LLM_PLANNER_PROVIDER=deepseek
DX_LLM_REVIEWER_PROVIDER=anthropic
DX_LLM_FALLBACK_PROVIDER=
# Live model calls remain disabled unless all outbound-call controls are reviewed.
DX_LLM_LIVE_ENABLED=false
DX_LLM_TIMEOUT_SECONDS=30
DX_LLM_MAX_RETRIES=0

# ---------------------------------------------------------------------------
# 6. TEST DATABASE
# ---------------------------------------------------------------------------
# Tests refuse to run unless these point to the disposable dxbrain_test database.
DX_TEST_DATABASE_URL=postgresql+psycopg://dx_api:replace-with-api-password@127.0.0.1:5432/dxbrain_test
DX_TEST_WORKER_DATABASE_URL=postgresql+psycopg://dx_worker:replace-with-worker-password@127.0.0.1:5432/dxbrain_test
DX_TEST_MIGRATION_DATABASE_URL=postgresql+psycopg://dx_migration:replace-with-migration-password@127.0.0.1:5432/dxbrain_test

# ---------------------------------------------------------------------------
# Docker bootstrap only (do NOT reuse these roles in the app runtime)
# ---------------------------------------------------------------------------
POSTGRES_DB=dxbrain
POSTGRES_USER=dx_bootstrap
POSTGRES_PASSWORD=replace-with-bootstrap-password
DX_MIGRATION_PASSWORD=replace-with-migration-password
DX_API_PASSWORD=replace-with-api-password
DX_WORKER_PASSWORD=replace-with-worker-password
DX_POSTGRES_PORT=5432

# ============================================================================
# ALEMBIC MIGRATION — important role note
# ============================================================================
# ``migrations/env.py`` reads DX_DATABASE_URL and requires it to be the dx_migration
# DSN. NEVER run Alembic with the dx_api DSN. Before any migration, override at the
# process level ONLY:
#
#   DX_DATABASE_URL=$DX_DATABASE_URL_MIGRATION  alembic upgrade head
#
# The dx_api principal is the application runtime role and must never be used to run
# schema migrations.
# ============================================================================
